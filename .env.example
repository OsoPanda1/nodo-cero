# ============================================================================
# RDM DIGITAL HUB — NODO CERO · Variables de entorno
# Despliegue en Vercel: Dashboard del proyecto → Settings → Environment Variables
# ============================================================================

# Isabella opera en vivo cuando alguna clave de la bóveda CROWN está
# configurada. Sin ninguna, Isabella responde en "modo simulación" con
# respuestas locales soberanas (SOPHIA), sin salida de datos.

# APP_URL: URL pública donde quedará alojada la plataforma (Vercel deployment URL
# o dominio personalizado). Se usa para enlaces autorreferenciales y APIs.
APP_URL="https://rdm-digital-hub.vercel.app"

# Otras variables opcionales:
# NEXT_PUBLIC_SITE_URL  → URL pública (para metadatos/OG) si APP_URL no basta.

# ============================================================================
# FRONTERA — política canónica de origen (anti-CSRF / CORS)
# ============================================================================
# CANONICAL_ORIGINS: lista separada por comas de orígenes exactos permitidos.
#   Ej: "https://tamv.online,https://www.tamv.online"
# TRUSTED_HOSTS: lista separada por comas de hostnames que el Nodo reconoce
#   como propios cuando NO hay orígenes canónicos configurados. Un Host que
#   no esté aquí es rechazado (fail-closed). El fallback de self-origin es
#   SOLO un mecanismo de recuperación de configuración incompleta, nunca
#   la configuración definitiva.
#   Ej: "tamv.online,www.tamv.online,api.tamv.online"
CANONICAL_ORIGINS=""
TRUSTED_HOSTS=""

# MEXA_OPERATOR_KEY: Secreto del operador para la Mexa API.
# Habilita el endpoint /api/isabella/crypto/sign (firmas MSR).
# Sin este secreto, los endpoints de firma responden 503 y solo /verify queda público.
MEXA_OPERATOR_KEY=""

# ============================================================================
# CROWN GATEWAY — Bóveda nativa de IAs open source
# Cada clave configura un proveedor más de la bóveda (Llama, Qwen, DeepSeek,
# Mistral, Phi, Cerebras). Sin claves, el Nodo opera en modo simulación
# soberano (SOPHIA local, sin egress).
# ============================================================================

# Bóveda open source — modelos servidos por transportes soberanos:
GROQ_API_KEY=""             # Llama 3.3 70B (Groq LPU)
OPENROUTER_API_KEY=""       # Qwen 2.5 72B / DeepSeek V3
CEREBRAS_API_KEY=""         # Llama 3.3 70B (Cerebras)
MISTRAL_API_KEY=""          # Mistral Nemo
CLOUDFLARE_AI_KEY=""        # Phi-3.5 Mini (junto a CLOUDFLARE_AI_ACCOUNT_ID)
CLOUDFLARE_AI_ACCOUNT_ID=""

# OLLAMA_BASE_URL: modelo local (zona roja, cero salida de datos).
# Ej: http://localhost:11434/v1 (endpoint OpenAI-compatible de Ollama)
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.1"

# CROWN_EMERGENCY_KEY: clave del operador para armar/desarmar el LOCKDOWN
# (POST /api/isabella/gateway/emergency). Si no se define, el Dead Man's
# Switch solo puede renovarse con 'heartbeat'.
CROWN_EMERGENCY_KEY=""

# CROWN_HEARTBEAT_TTL_MS: ventana del Dead Man's Switch (por defecto 60_000).
# Si el operador deja de emitir latidos más de este tiempo, el Nodo entra en
# LOCKDOWN automáticamente.
CROWN_HEARTBEAT_TTL_MS="60000"

# ============================================================================
# GAMIFICATION YUN — Zombies RDM Invasion (server-authoritative)
# ============================================================================

# GAMIFICATION_HMAC_SECRET: firma HMAC-SHA256 de los tokens de sesión de juego.
# El backend valida integridad y caducidad de cada evento antes de otorgar
# puntos (anti-cheat). Sin este secreto el Nodo opera en modo 'open' (demo):
# se validan estructura, caducidad y vínculo deviceId↔sesión, sin integridad
# criptográfica. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAMIFICATION_HMAC_SECRET=""

# ============================================================================
# CLAVES INTERNAS (Key Vault) — autenticación entre módulos del Nodo
# Cada clave alimenta una capa de identidad de la cadena Zero Trust.
# Rotación: añade _V2/_V3 al nombre para escalar versiones sin downtime.
# Genera cada una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# ISA_API_KEY: autenticación del núcleo cognitivo ISA (capa de identidad L6).
ISA_API_KEY=""

# MEXA_API_KEY: autenticación de la API interna MEXA (firmas MSR).
MEXA_API_KEY=""

# GAMIFICATION_API_KEY: autorización del motor de juego / anti-cheat.
GAMIFICATION_API_KEY=""

# MONITOR_API_KEY: acceso de solo lectura al Monitor General (/api/monitor/*).
MONITOR_API_KEY=""

# CROWN_API_KEY: autenticación de la flota de agentes CROWN (open science).
CROWN_API_KEY=""

# ============================================================================
# LICENCIAMIENTO — sello de integridad del build
# BUILD_SEAL_KEY: clave HMAC para firmar el sello de versión del Nodo
# (manifiesto de integridad del build para licenciamiento). Sin esta clave
# el Nodo opera con sello 'open' (sin integridad criptográfica). Genera una
# con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================
BUILD_SEAL_KEY=""

