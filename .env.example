# ============================================================================
# RDM DIGITAL HUB — NODO CERO · Variables de entorno
# Despliegue en Vercel: Dashboard del proyecto → Settings → Environment Variables
# ============================================================================

# GEMINI_API_KEY: Requerida para activar Isabella Villaseñor AI en vivo.
# Obtenla en https://aistudio.google.com/apikey
# Si no se define, Isabella opera en "modo simulación" con respuestas locales.
GEMINI_API_KEY=""

# APP_URL: URL pública donde quedará alojada la plataforma (Vercel deployment URL
# o dominio personalizado). Se usa para enlaces autorreferenciales y APIs.
APP_URL="https://rdm-digital-hub.vercel.app"

# Otras variables opcionales:
# NEXT_PUBLIC_SITE_URL  → URL pública (para metadatos/OG) si APP_URL no basta.

# MEXA_OPERATOR_KEY: Secreto del operador para la Mexa API.
# Habilita el endpoint /api/isabella/crypto/sign (firmas MSR).
# Sin este secreto, los endpoints de firma responden 503 y solo /verify queda público.
MEXA_OPERATOR_KEY=""

# ============================================================================
# CROWN GATEWAY — Flota federada de IAs
# Cada clave configura un proveedor más en el gateway. Sin claves, el Nodo
# opera en modo simulación soberano (SOPHIA local, sin egress).
# ============================================================================

# GEMINI_API_KEY duplica la flota (proveedor 'gemini', zona verde).
GROQ_API_KEY=""
AI_GATEWAY_API_KEY=""      # Vercel AI Gateway / proxy
CEREBRAS_API_KEY=""
MISTRAL_API_KEY=""
OPENROUTER_API_KEY=""
CLOUDFLARE_AI_KEY=""       # junto a CLOUDFLARE_AI_ACCOUNT_ID
CLOUDFLARE_AI_ACCOUNT_ID=""

# OLLAMA_BASE_URL: modelo local (zona roja, cero salida de datos).
# Ej: http://localhost:11434/v1 (endpoint OpenAI-compatible de Ollama)
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.1"

# CROWN_EMERGENCY_KEY: clave del operador para armar/desarmar el LOCKDOWN
# (POST /api/isabella/gateway/emergency). Si no se define, el Dead Man's
# Switch solo puede renovarse con 'heartbeat'.
CROWN_EMERGENCY_KEY=""

# CROWN_HEARTBEAT_TTL_MS: ventana del Dead Man's Switch (por defecto 60_000).
# Si el operador deja de emitir latidos más de este tiempo, el Nodo entra en
# LOCKDOWN automáticamente.
CROWN_HEARTBEAT_TTL_MS="60000"
